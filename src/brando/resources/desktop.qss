QMainWindow, QWidget#windowBody { background: $background; }
QWidget { color: $text; font-size: 14px; }
QLabel { background: transparent; }
QLabel#brandTitle { font-size: 30px; font-weight: 700; }
QLabel#dropTitle { font-size: 23px; font-weight: 600; }
QLabel#sectionTitle, QLabel#commentTitle { font-size: 18px; font-weight: 600; }
QLabel#optionLabel { font-size: 13px; font-weight: 600; }
QLabel[secondary="true"] { color: $muted; font-size: 13px; }
QFrame#optionsCard { background: $surface; border: 1px solid $border; border-radius: 16px; }
QFrame#dropZone { background: $surface; border: 2px dashed $drop_border; border-radius: 16px; }
QFrame#dropZone[dragActive="true"] { background: $comment; border: 2px solid $accent; }
QFrame#commentsCard { background: $comment; border: 1px solid $comment_border; border-radius: 14px; }
QLineEdit, QComboBox, QPlainTextEdit {
    background: $input;
    color: $text;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: $accent;
    selection-color: $on_accent;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border: 1px solid $accent; }
QLineEdit:disabled, QComboBox:disabled { background: $disabled; color: $muted; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url("$chevron"); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: $surface;
    color: $text;
    selection-background-color: $accent;
    selection-color: $on_accent;
    border: 1px solid $border;
    padding: 4px;
}
QPushButton {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: 9px;
    padding: 9px 14px;
    font-weight: 600;
}
QPushButton:hover { background: $hover; border-color: $accent; }
QPushButton:focus, QToolButton:focus { border: 2px solid $accent; }
QPushButton:pressed { background: $comment; }
QPushButton:disabled { background: $disabled; color: $disabled_text; border-color: $border; }
QPushButton#convertButton { background: $accent; color: $on_accent; border: 1px solid $accent; }
QPushButton#convertButton:hover { background: $accent_hover; }
QPushButton#convertButton:disabled { background: $disabled; color: $disabled_text; border-color: $border; }
QToolButton { background: transparent; border: 1px solid transparent; padding: 3px; }
QToolButton#optionInfo {
    background: $info;
    color: $accent;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
}
QToolButton#optionInfo:hover { background: $hover; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: $background; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: $border; min-height: 25px; border-radius: 5px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QProgressBar { background: $border; border: none; border-radius: 2px; min-height: 4px; max-height: 4px; }
QProgressBar::chunk { background: $accent; border-radius: 2px; }
QFrame#conversionStatus { background: $disabled; border: 1px solid $border; border-radius: 12px; }
QFrame#conversionStatus QLabel#statusText { color: $muted; font-weight: 600; }
QLabel#statusDot { background: $muted; border-radius: 4px; }
QFrame#conversionStatus[state="ready"] { background: $ready_background; border-color: $ready_text; }
QFrame#conversionStatus[state="ready"] QLabel#statusText { color: $ready_text; }
QFrame#conversionStatus[state="ready"] QLabel#statusDot { background: $ready_text; }
QFrame#conversionStatus[state="busy"] { background: $info; border-color: $accent; }
QFrame#conversionStatus[state="busy"] QLabel#statusText { color: $accent; }
QFrame#conversionStatus[state="busy"] QLabel#statusDot { background: $accent; }
QFrame#conversionStatus[state="error"] { background: $error_background; border-color: $error_text; }
QFrame#conversionStatus[state="error"] QLabel#statusText { color: $error_text; }
QFrame#conversionStatus[state="error"] QLabel#statusDot { background: $error_text; }
QToolTip {
    background: $tooltip;
    color: $tooltip_text;
    border: 1px solid $border;
    padding: 10px;
    max-width: 300px;
}
